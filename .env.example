# Copiar a .env y completar con los valores reales (el .env no se versiona)

# Azure SQL: sacar servidor, base y usuario del portal de Azure
DATABASE_URL="sqlserver://SERVIDOR.database.windows.net:1433;database=BASE;user=USUARIO;password=CONTRASEÑA;encrypt=true;connectTimeout=90;poolTimeout=90"

# Al menos 32 caracteres al azar
JWT_SECRET="cambiar-por-un-secreto-largo-de-al-menos-32-caracteres"

PORT=3000

# Origen del front (Vite usa el 5173). Exacto: con el puerto y sin barra final
CORS_ORIGIN="http://localhost:5173"

# Credenciales de la API de Stays (las da el soporte de Stays). El dominio va sin https://
STAYS_DOMAIN=""
STAYS_CLIENT_ID=""
STAYS_CLIENT_SECRET=""

# Solo los usa el seed para crear el primer administrador
SEED_ADMIN_NOMBRE="admin"
SEED_ADMIN_PASSWORD="cambiar-esta-contraseña"
